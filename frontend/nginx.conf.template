server {
    # nginx-unprivileged runs as a non-root user: it can't bind port 80.
    listen 8080;
    server_name localhost;

    # The chart of a large group is several MB of JSON: compressed, about ten times less.
    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/css image/svg+xml;

    # Serve the React build
    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Transparent proxy to the Go backend. NORNIR_BACKEND_URL is substituted when the
    # container starts (envsubst on /etc/nginx/templates); nginx variables are left alone.
    location /api/ {
        proxy_pass ${NORNIR_BACKEND_URL}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s; # fail fast when the backend is down
        # The first fetch of a large group walks many GitLab pages; later ones hit the cache.
        proxy_read_timeout 300s;
    }
}
